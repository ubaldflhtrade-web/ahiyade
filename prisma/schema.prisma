generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum Department {
  ALIBORI
  ATACORA
  ATLANTIQUE
  BORGOU
  COLLINES
  COUFFO
  DONGA
  LITTORAL
  MONO
  OUEME
  PLATEAU
  ZOU
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum QuoteStatus {
  PENDING
  REPLIED
  CLOSED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  FEDAPAY
  MTN_MOMO
  MOOV_MONEY
  CARD
}

enum NotificationType {
  WELCOME
  ACCOUNT_VALIDATED
  QUOTE_REQUEST
  QUOTE_REPLY
  MESSAGE
  SUBSCRIPTION
  SYSTEM
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  role          Role          @default(BUYER)
  plan          Plan          @default(FREE)
  isVerified    Boolean       @default(false)
  status        AccountStatus @default(PENDING)
  department    Department?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplierProfile SupplierProfile?
  buyerProfile    BuyerProfile?
  products        Product[]         @relation("SupplierProducts")
  quoteRequests   QuoteRequest[]    @relation("BuyerQuotes")
  receivedQuotes  QuoteRequest[]    @relation("SupplierQuotes")
  sentMessages    Message[]         @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  subscriptions   Subscription[]
  notifications   Notification[]
  favorites       Favorite[]        @relation("BuyerFavorites")
  supplierFavorites SupplierFavorite[] @relation("BuyerSupplierFavorites")
  favoritedByBuyers SupplierFavorite[] @relation("SupplierFavoritedBy")
  ratingsGiven    SupplierRating[]  @relation("RatingsGiven")
  ratingsReceived SupplierRating[]  @relation("RatingsReceived")

  @@index([role])
  @@index([department])
  @@index([status])
}

model SupplierProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  companyName String
  logo        String?
  description String
  department  Department
  phone       String
  website     String?
  rating      Decimal    @default(0) @db.Decimal(3, 2)
  isFeatured  Boolean    @default(false)
  views       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([isFeatured])
}

model BuyerProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  companyName String
  description String?
  department  Department
  phone       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameFr    String
  nameEn    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  supplierId  String
  categoryId  String
  name        String
  description String
  price       Decimal     @db.Decimal(12, 2)
  stock       Int
  department  Department
  images      String[]
  isActive    Boolean     @default(true)
  views       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  supplier      User           @relation("SupplierProducts", fields: [supplierId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  quoteRequests QuoteRequest[]
  favorites     Favorite[]

  @@index([supplierId])
  @@index([categoryId])
  @@index([department])
  @@index([isActive])
  @@index([price])
}

model QuoteRequest {
  id         String      @id @default(cuid())
  buyerId    String
  supplierId String
  productId  String
  message    String
  status     QuoteStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  buyer    User    @relation("BuyerQuotes", fields: [buyerId], references: [id], onDelete: Cascade)
  supplier User    @relation("SupplierQuotes", fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([supplierId])
  @@index([productId])
  @@index([status])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String
  plan          Plan               @default(PREMIUM)
  startDate     DateTime
  endDate       DateTime
  paymentMethod PaymentMethod
  status        SubscriptionStatus @default(PENDING)
  transactionId String?            @unique
  invoiceUrl    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Favorite {
  id        String   @id @default(cuid())
  buyerId   String
  productId String
  createdAt DateTime @default(now())

  buyer   User    @relation("BuyerFavorites", fields: [buyerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@index([productId])
}

model SupplierFavorite {
  id         String   @id @default(cuid())
  buyerId    String
  supplierId String
  createdAt  DateTime @default(now())

  buyer    User @relation("BuyerSupplierFavorites", fields: [buyerId], references: [id], onDelete: Cascade)
  supplier User @relation("SupplierFavoritedBy", fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([buyerId, supplierId])
  @@index([supplierId])
}

model SupplierRating {
  id         String   @id @default(cuid())
  buyerId    String
  supplierId String
  score      Int
  comment    String?
  createdAt  DateTime @default(now())

  buyer    User @relation("RatingsGiven", fields: [buyerId], references: [id], onDelete: Cascade)
  supplier User @relation("RatingsReceived", fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([buyerId, supplierId])
  @@index([supplierId])
}
